---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mountains from '../components/Mountains.astro';
import CtaBand from '../components/CtaBand.astro';
import headshot from '../assets/steven-toth.webp';
import { neighbourhoods } from '../data/neighbourhoods';
import { site } from '../data/site';

const services = [
  {
    title: 'Buying',
    text: 'From first condo to forever home. I’ll help you understand the market, find the right fit and negotiate with confidence.',
    href: '/buying',
  },
  {
    title: 'Selling',
    text: 'Accurate pricing, careful preparation and marketing that presents your home at its best, so it sells for the right price.',
    href: '/selling',
  },
  {
    title: 'New to Vancouver',
    text: 'Moving from elsewhere? I’ve lived overseas myself. I’ll introduce you to the neighbourhoods and help you settle in.',
    href: '/neighbourhoods',
  },
  {
    title: 'Investing',
    text: 'Condo and multi-unit opportunities, rental considerations and strata due diligence, from someone trained in condo specifics.',
    href: '/contact?intent=invest',
  },
];

const steps = [
  { title: 'A real conversation', text: 'We start with your goals, timing and budget, not a sales pitch.' },
  { title: 'A clear plan', text: 'Pricing, neighbourhoods, financing and timelines, laid out so there are no surprises.' },
  { title: 'Search or prepare', text: 'Curated listings for buyers, or staging, photography and marketing for sellers.' },
  { title: 'Negotiate & close', text: 'Clear advice through offers, subjects and completion, and I’m still here after the keys change hands.' },
];

const kitsLife = [
  'Morning swims at Kits Pool and sunset volleyball on Kits Beach',
  'Coffee, bakeries and boutiques along West 4th Avenue',
  'Car-free rides on the Arbutus Greenway and seaside bike routes',
  'Ten minutes to downtown, Granville Island and UBC',
];

const faq = [
  {
    q: 'Which areas of Vancouver does Steven Toth work in?',
    a: 'Steven is based in Kitsilano and focuses on Vancouver’s Westside, including Kitsilano, Point Grey, Dunbar, Kerrisdale, Arbutus Ridge, Shaughnessy and Fairview. He also helps clients in Mount Pleasant, Downtown and across the Lower Mainland.',
  },
  {
    q: 'Do you work with first-time buyers?',
    a: 'Absolutely. First-time buyers are some of my favourite clients. I’ll walk you through pre-approval, deposits, subjects, strata documents and closing costs so you know exactly what to expect.',
  },
  {
    q: 'How do I find out what my home is worth?',
    a: 'Get in touch for a no-obligation market evaluation. I’ll look at recent comparable sales, current competition and your home’s features to give you a realistic price range.',
  },
  {
    q: 'Which brokerage are you with?',
    a: `Steven Toth Personal Real Estate Corporation is with ${site.brokerage} in Vancouver.`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="Steven Toth | Kitsilano & Vancouver Westside REALTOR®"
  description="Steven Toth is a Kitsilano-based REALTOR® with Macdonald Realty, born and raised on Vancouver's Westside. Expert help buying and selling homes and condos in Kits, Point Grey, Dunbar, Kerrisdale and across Vancouver."
  jsonLd={[faqSchema]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Kitsilano · Vancouver Westside</span>
        <h1>Vancouver real estate, from someone who grew up here.</h1>
        <p class="lede">
          I’m Steven Toth. I was born and raised on Vancouver’s Westside, and now I live in Kits with my wife and two
          daughters. Whether you’re buying your first condo, selling the family home or moving to the city, I’ll help
          you make the right move.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary" href="/contact">Tell me what you’re looking for</a>
          <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phone}</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="arch">
          <Picture
            src={headshot}
            alt="Steven Toth, Vancouver REALTOR®, smiling in a black polo shirt"
            widths={[360, 540, 720]}
            sizes="(min-width: 900px) 420px, 80vw"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <div class="badge">
          <span class="badge-label">Personal Real Estate Corporation</span>
          <span class="badge-value">{site.brokerage}</span>
        </div>
      </div>
    </div>
    <Mountains class="hero-ridge" />
  </section>

  <section class="facts" aria-label="Quick facts">
    <div class="container">
      <dl class="facts-grid">
        <div><dt>Born &amp; raised</dt><dd>Vancouver Westside</dd></div>
        <div><dt>Lives in</dt><dd>Kitsilano</dd></div>
        <div><dt>Educated at</dt><dd>UBC</dd></div>
        <div><dt>Condo-trained</dt><dd>Condo 101 &amp; 202</dd></div>
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How I can help</span>
        <h2>Real estate advice that puts your goals first</h2>
        <p class="lede">
          Every move is different. My job is to give you honest advice, local knowledge and steady guidance from the
          first conversation to the day you get the keys, and after that too.
        </p>
      </div>
      <div class="grid grid--4">
        {
          services.map((s) => (
            <a class="card service" href={s.href}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
              <span class="more" aria-hidden="true">
                Learn more →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--mist kits">
    <div class="container kits-grid">
      <div>
        <span class="eyebrow">Why Kits</span>
        <h2>Living the Kitsilano life, every day</h2>
        <p class="lede">
          Kitsilano isn’t just where I work, it’s where my family lives. I know which blocks catch the evening sun (when it’s not raining),
          which buildings are well run, and where the best croissant on West 4th is.
        </p>
        <ul class="check-list">
          {kitsLife.map((item) => <li>{item}</li>)}
        </ul>
        <a class="btn btn--ghost" href="/neighbourhoods/kitsilano">Explore Kitsilano</a>
      </div>
      <figure class="kits-art" aria-hidden="true">
        <svg viewBox="0 0 480 400" role="presentation">
          <defs>
            <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#cfdccf"></stop>
              <stop offset="0.6" stop-color="#e6ede0"></stop>
              <stop offset="1" stop-color="#eef2e6"></stop>
            </linearGradient>
            <linearGradient id="water" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#3f7a66"></stop>
              <stop offset="1" stop-color="#143726"></stop>
            </linearGradient>
          </defs>
          <rect width="480" height="400" rx="28" fill="url(#sky)"></rect>
          <circle cx="340" cy="120" r="38" fill="#f6f4df" opacity="0.9"></circle>
          <path d="M0 200 L70 140 L120 170 L190 100 L260 165 L320 125 L390 175 L440 140 L480 160 V250 H0Z" fill="#8fae98"></path>
          <ellipse cx="200" cy="168" rx="190" ry="16" fill="#f3f6ee" opacity="0.7"></ellipse>
          <path d="M0 225 L90 180 L160 210 L240 165 L320 215 L400 185 L480 210 V260 H0Z" fill="#4f7d61"></path>
          <path d="M-7.7 248 L-4.0 230.2 L-0.3 248ZM0.5 248 L4.7 228.1 L8.9 248ZM8.7 248 L13.7 224.0 L18.8 248ZM17.1 248 L20.1 233.8 L23.1 248ZM26.4 248 L30.3 229.9 L34.1 248ZM31.1 248 L37.4 218.1 L43.7 248ZM40.0 248 L45.8 220.6 L51.5 248ZM49.1 248 L54.2 223.8 L59.2 248ZM55.8 248 L60.9 223.8 L66.0 248ZM66.6 248 L71.3 225.6 L76.0 248ZM75.8 248 L81.0 223.3 L86.2 248ZM81.8 248 L87.3 221.9 L92.8 248ZM92.3 248 L96.2 229.2 L100.2 248ZM96.5 248 L102.4 220.2 L108.2 248ZM105.4 248 L110.8 222.5 L116.1 248ZM115.8 248 L121.1 222.6 L126.5 248ZM127.5 248 L131.8 227.7 L136.0 248ZM137.3 248 L141.8 226.9 L146.2 248ZM146.5 248 L152.4 219.9 L158.3 248ZM155.5 248 L158.9 231.8 L162.3 248ZM159.8 248 L166.0 218.6 L172.2 248ZM169.1 248 L174.2 224.0 L179.2 248ZM177.1 248 L181.7 225.9 L186.3 248ZM185.5 248 L189.6 228.4 L193.7 248ZM193.6 248 L198.5 224.7 L203.5 248ZM203.8 248 L209.1 223.1 L214.3 248ZM213.9 248 L219.7 220.3 L225.5 248ZM225.5 248 L230.7 223.3 L235.9 248ZM231.7 248 L237.5 220.2 L243.3 248ZM242.3 248 L248.3 219.5 L254.3 248ZM251.8 248 L257.2 222.6 L262.5 248ZM258.5 248 L264.2 220.7 L269.9 248ZM269.2 248 L273.1 229.4 L277.0 248ZM273.6 248 L279.4 220.3 L285.2 248ZM287.1 248 L290.3 232.6 L293.6 248ZM296.0 248 L300.3 227.4 L304.7 248ZM303.2 248 L307.1 229.3 L311.0 248ZM311.1 248 L316.9 220.0 L322.8 248ZM318.2 248 L323.2 224.2 L328.2 248ZM324.0 248 L329.4 222.5 L334.7 248ZM331.1 248 L337.0 219.9 L342.9 248ZM343.3 248 L347.9 225.9 L352.6 248ZM355.0 248 L358.9 229.0 L362.9 248ZM360.4 248 L365.3 224.4 L370.3 248ZM367.9 248 L371.5 230.8 L375.1 248ZM374.5 248 L379.5 224.2 L384.5 248ZM383.2 248 L386.3 233.3 L389.4 248ZM392.6 248 L396.6 229.0 L400.6 248ZM401.5 248 L407.4 219.7 L413.4 248ZM410.8 248 L415.3 226.6 L419.8 248ZM418.8 248 L423.9 223.7 L429.0 248ZM428.1 248 L432.9 225.1 L437.7 248ZM435.9 248 L442.0 219.0 L448.1 248ZM446.1 248 L450.5 227.1 L454.9 248ZM456.4 248 L460.1 230.2 L463.9 248ZM461.4 248 L467.6 218.4 L473.9 248ZM471.5 248 L476.3 225.2 L481.0 248ZM478.0 248 L482.3 227.4 L486.6 248Z" fill="#24503a"></path>
          <rect y="245" width="480" height="90" fill="url(#water)"></rect>
          <path d="M40 272 h60 M150 292 h80 M300 270 h70 M360 302 h60" stroke="#a9d1bc" stroke-width="3" stroke-linecap="round" opacity="0.55"></path>
          <g transform="translate(150 230)">
            <path d="M0 0 L0 44 L-30 44Z" fill="#f7f9f2"></path>
            <path d="M4 6 L4 44 L28 44Z" fill="#7fb35a"></path>
            <path d="M-36 48 H34 L26 58 H-28Z" fill="#0e2218"></path>
          </g>
          <path d="M0 330 C120 312 260 340 480 318 V400 H0Z" fill="#e4dcc2"></path>
          <path d="M371.4 336 L380.0 295.2 L388.6 336ZM375.6 336 L389.1 272.0 L402.5 336ZM382.0 336 L395.4 272.2 L408.8 336ZM389.9 336 L403.7 270.2 L417.5 336ZM397.4 336 L411.5 269.1 L425.5 336ZM412.6 336 L421.2 295.2 L429.7 336ZM413.7 336 L427.5 270.3 L441.3 336ZM427.9 336 L438.3 286.5 L448.7 336ZM433.4 336 L446.6 273.5 L459.7 336ZM442.9 336 L454.2 282.2 L465.5 336ZM450.4 336 L461.7 282.0 L473.1 336ZM459.9 336 L470.7 284.6 L481.5 336ZM464.0 336 L478.6 266.7 L493.2 336ZM471.8 336 L484.7 274.4 L497.7 336Z" fill="#1f4a33"></path>
          <path d="M-15.8 340 L-6.0 293.5 L3.8 340ZM-12.2 340 L1.1 276.7 L14.4 340ZM-0.6 340 L8.3 297.6 L17.2 340ZM3.9 340 L16.5 280.3 L29.0 340ZM13.1 340 L23.0 293.1 L32.9 340ZM17.1 340 L30.7 275.7 L44.2 340ZM25.2 340 L38.9 274.9 L52.5 340ZM35.7 340 L45.7 292.6 L55.7 340ZM41.1 340 L55.0 273.9 L68.8 340ZM54.0 340 L63.2 296.3 L72.4 340ZM58.5 340 L69.8 286.0 L81.2 340Z" fill="#1f4a33"></path>
          <rect x="0" y="0" width="480" height="400" rx="28" fill="none" stroke="#d5dfca"></rect>
        </svg>
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head split">
        <div>
          <span class="eyebrow">Neighbourhoods</span>
          <h2>Know the neighbourhood before you move</h2>
        </div>
        <a class="btn btn--ghost" href="/neighbourhoods">All neighbourhoods</a>
      </div>
      <div class="grid grid--3">
        {
          neighbourhoods.slice(0, 6).map((n) => (
            <a class="card hood" href={`/neighbourhoods/${n.slug}`}>
              <h3>{n.name}</h3>
              <p>{n.summary}</p>
              <span class="more" aria-hidden="true">
                Explore →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--mist">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The process</span>
        <h2>Simple, transparent, and done right</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li>
              <span class="step-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow">Questions</span>
        <h2>Frequently asked</h2>
        <p class="lede">Have a question that isn’t here? <a href="/contact">Just ask</a>.</p>
      </div>
      <div class="faq">
        {
          faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    background: linear-gradient(180deg, #e6efdc 0%, #cfe0c3 100%);
    padding-top: clamp(40px, 6vw, 80px);
    padding-bottom: clamp(110px, 14vw, 190px);
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.25fr 1fr;
    }
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: min(420px, 82vw);
  }
  .arch {
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    overflow: hidden;
    background: var(--moss-light);
    box-shadow: 0 30px 60px -20px rgb(20 45 30 / 0.35);
    aspect-ratio: 4 / 5;
  }
  .arch :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .badge {
    position: absolute;
    left: -8px;
    bottom: 28px;
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-radius: var(--radius);
    padding: 12px 18px;
    box-shadow: var(--shadow);
    max-width: 80%;
  }
  .badge-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }
  .badge-value {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }
  .hero-ridge {
    --ridge-far: #8fb39a;
    --ridge-far-opacity: 0.55;
    --ridge-mid: #3d6e50;
    --ridge-mid-opacity: 0.55;
    --ridge-trees: #1f4a33;
    --ridge-trees-opacity: 0.9;
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(70px, 11vw, 150px);
    color: var(--paper);
  }

  .facts {
    margin-top: -24px;
    position: relative;
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin: 0;
  }
  @media (min-width: 820px) {
    .facts-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .facts-grid > div {
    background: var(--white);
    padding: 20px 24px;
  }
  .facts-grid dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
  }
  .facts-grid dd {
    margin: 4px 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 560;
  }

  .section-head {
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .section-head.split {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
  }

  .service,
  .hood {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.2s,
      box-shadow 0.2s,
      border-color 0.2s;
  }
  .service:hover,
  .hood:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--mist-deep);
    color: var(--ink);
  }
  .service p,
  .hood p {
    color: var(--ink-soft);
    flex: 1;
  }
  .more {
    font-weight: 600;
    color: var(--forest);
    font-size: 0.95rem;
  }

  .kits-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .kits-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .kits .check-list {
    margin-block: 24px 32px;
  }
  .kits-art {
    margin: 0;
  }
  .kits-art svg {
    width: 100%;
    filter: drop-shadow(0 24px 40px rgb(20 45 30 / 0.18));
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 24px;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .steps li {
    border-top: 2px solid var(--ink);
    padding-top: 20px;
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--fern);
    line-height: 1;
    margin-bottom: 12px;
  }
  .steps p {
    color: var(--ink-soft);
  }

  .faq-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: 1fr 1.6fr;
    }
  }
  .faq details {
    border-bottom: 1px solid var(--line);
    padding: 20px 0;
  }
  .faq details:first-child {
    border-top: 1px solid var(--line);
  }
  .faq summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 560;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary::after {
    content: '+';
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--fern);
    transition: transform 0.2s;
  }
  .faq details[open] summary::after {
    transform: rotate(45deg);
  }
  .faq details p {
    margin: 12px 0 0;
    color: var(--ink-soft);
  }
</style>
