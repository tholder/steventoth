---
import Mountains from './Mountains.astro';
import { site } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Thinking about a move?',
  text = 'Tell me a little about what you’re looking for. I’ll get back to you personally, usually the same day.',
  href = '/contact',
  label = 'Start the conversation',
} = Astro.props;
---

<section class="cta section--sea">
  <Mountains class="cta-ridge" />
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn--primary" href={href}>{label}</a>
      <a class="btn btn--ghost" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 10vw, 120px) clamp(64px, 8vw, 96px);
  }
  .cta-ridge {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 45%;
    color: #0c2433;
  }
  .cta-inner {
    position: relative;
    display: grid;
    gap: 28px;
    align-items: end;
  }
  .cta h2 {
    color: var(--sand);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .cta-inner {
      grid-template-columns: 1.4fr 1fr;
    }
    .cta-actions {
      justify-content: flex-end;
    }
  }
</style>
