---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${site.name}, home`}>
      <span class="brand-name">Steven Toth</span>
      <span class="brand-sub">REALTOR® · {site.brokerage}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <span class="menu-icon" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="nav-phone" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn--primary nav-cta" href="/contact">Let’s talk</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const header = document.querySelector('.site-header');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(251 248 243 / 0.9);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid rgb(226 216 199 / 0.7);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 72px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    line-height: 1.1;
  }
  .brand-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-sub {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 3px;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav ul a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.97rem;
    padding-block: 6px;
    border-bottom: 2px solid transparent;
  }
  .nav ul a:hover,
  .nav ul a[aria-current='page'] {
    border-bottom-color: var(--sunset);
    color: var(--ink);
  }
  .nav-phone {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .nav-cta {
    padding: 0.65em 1.25em;
  }
  .menu-toggle {
    display: none;
  }

  @media (max-width: 960px) {
    .nav-phone {
      display: none;
    }
  }

  @media (max-width: 820px) {
    .menu-toggle {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 1px solid var(--line);
      border-radius: 12px;
      background: var(--white);
      cursor: pointer;
    }
    .menu-icon,
    .menu-icon::before,
    .menu-icon::after {
      display: block;
      width: 18px;
      height: 2px;
      background: var(--ink);
      border-radius: 2px;
      transition: transform 0.2s;
      position: relative;
    }
    .menu-icon::before,
    .menu-icon::after {
      content: '';
      position: absolute;
      left: 0;
    }
    .menu-icon::before {
      top: -6px;
    }
    .menu-icon::after {
      top: 6px;
    }
    .is-open .menu-icon {
      background: transparent;
    }
    .is-open .menu-icon::before {
      transform: translateY(6px) rotate(45deg);
    }
    .is-open .menu-icon::after {
      transform: translateY(-6px) rotate(-45deg);
    }

    .nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 16px var(--gutter) 24px;
      background: var(--paper);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .is-open .nav {
      display: flex;
    }
    .nav ul {
      flex-direction: column;
      gap: 0;
    }
    .nav ul a {
      display: block;
      padding: 12px 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }
    .nav-phone {
      display: block;
      padding: 12px 0;
    }
  }
</style>
