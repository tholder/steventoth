{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/index.php", "destination": "/", "permanent": true },
    { "source": "/AboutMe.ubr", "destination": "/about", "permanent": true },
    { "source": "/Properties.php", "destination": "/properties", "permanent": true },
    { "source": "/MLS/:path*", "destination": "/properties", "permanent": true },
    { "source": "/MarketUpdate.ubr", "destination": "/", "permanent": true },
    { "source": "/(SeptemberStats|AugustStats).ubr", "destination": "/", "permanent": true },
    { "source": "/(MarketingPlan|ImportanceofPricing|PreparingYourHome).ubr", "destination": "/selling", "permanent": true },
    { "source": "/(ClosingCosts|MortgageInformation|TypesofHomeOwnership).ubr", "destination": "/buying", "permanent": true },
    { "source": "/:page([A-Za-z]+).ubr", "destination": "/", "permanent": true },
    { "source": "/PrivacyPolicy.php", "destination": "/privacy", "permanent": true },
    { "source": "/Sitemap.php", "destination": "/sitemap-index.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
