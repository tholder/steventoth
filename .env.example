# Contact form delivery (https://resend.com). Set these in Vercel → Project → Settings → Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where enquiries are delivered
CONTACT_TO_EMAIL=steven@example.com
# Must be an address on a domain verified in Resend, e.g. "Steven Toth Website <hello@steventoth.ca>"
CONTACT_FROM_EMAIL=Steven Toth Website <onboarding@resend.dev>
